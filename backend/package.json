{
  "name": "ecochat-backend",
  "version": "1.0.0",
  "description": "EcoChatBot-Marcx — Backend (FastAPI + Node helpers: MongoDB, Redis, MicroSIP, OCR, IA)",
  "private": true,
  "author": "Aldemir Queiroz",
  "license": "ISC",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "debug": "node --inspect src/server.js",

    "py:start": "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "py:start:prod": "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4",
    "py:export:openapi": "python3 export_openapi.py",

    "db:ping:mongo": "node scripts/ping-mongo.js",
    "db:ping:redis": "node scripts/ping-redis.js",
    "db:ping:all": "concurrently \"npm run db:ping:mongo\" \"npm run db:ping:redis\"",

    "test": "node --test",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "redis": "^4.7.0",
    "ioredis": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.14.0",

    "socket.io": "^4.7.5",
    "sip.js": "^0.21.2",

    "tesseract.js": "^5.1.0",
    "sharp": "^0.33.4",
    "pdf-parse": "^1.1.1",

    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "axios": "^1.7.2",
    "form-data": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3"
  }
}
