# ═══════════════════════════════════════════════════════════════
# EcoChatBot-MA — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.
# ═══════════════════════════════════════════════════════════════

# ── Aplicação ────────────────────────────────────────────────
APP_NAME=EcoChatBot-MA
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_PORT=3000
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-32-chars

# ── Banco de dados (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://ecochat:ecochat123@localhost:5432/ecochat_marcx
# Para SQLite em desenvolvimento:
# DATABASE_URL=sqlite:///./ecochat.db

# ── Autenticação JWT ─────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480       # 8 horas

# ── Evolution API (WhatsApp) ──────────────────────────────────
# Self-hosted (padrão):  EVOLUTION_API_URL=http://localhost:8080
# EvoAI Cloud:           EVOLUTION_API_URL=https://api.evoai.app
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-global-da-evolution-api
# Header de autenticação:
#   "apikey"           → Evolution API self-hosted (padrão)
#   "api_access_token" → EvoAI Cloud Platform
EVOLUTION_AUTH_HEADER=apikey

# ── DeepSeek (IA) ────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=500
DEEPSEEK_TEMPERATURE=0.7

# ── Webhook ──────────────────────────────────────────────────
WEBHOOK_URL=https://seu-dominio.com/api/webhook
WEBHOOK_SECRET=token-secreto-para-validar-webhook


# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/ecochat.log

# ── Acessibilidade por voz (texto → fala) ─────────────────────
AUDIO_DIR=audios_gerados     # Pasta onde os MP3s gerados são salvos
AUDIO_TTS_LANG=pt-br         # Idioma da síntese de voz (gTTS)
AUDIO_MAX_CHARS=2000         # Tamanho máximo de texto por requisição
AUDIO_TTL_MINUTES=60         # Tempo de vida dos áudios antes da limpeza automática
# URL pública pela qual a Evolution API busca os áudios gerados (precisa
# ser alcançável pela instância da Evolution, não só pelo backend).
# Em produção, troque pelo domínio real (ex: https://api.seudominio.com.br).
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Seed inicial (init_db.py) ───────────────────────────────
# ADMIN_SENHA sobrescreve a senha padrão do admin de bootstrap definida em
# seed_data.py - defina um valor forte fora do ambiente local.
ADMIN_SENHA=admin123
# SEED_DEMO_USERS=true cria, além do admin, usuários fictícios de teste
# (um por canal). Mantenha false/ausente em produção.
SEED_DEMO_USERS=true
